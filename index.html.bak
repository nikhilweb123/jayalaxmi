              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h10l1 5a8 8 0 11-12 0l1-5z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v3M15 3v3" /></svg>
